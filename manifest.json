{
  "name": "Khoros Tools",
  "description": "Fix Khoros spoilers, Clean unfriendly HTML for Khoros, search using Khoros SQL, Get advice from HP's virtual agent",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": [ "contextMenus", "storage", "clipboardRead", "clipboardWrite", "activeTab", "scripting", "tabs" ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {},
  "icons": {
    "16": "hp16.png",
    "48": "hp48.png",
    "128": "hp128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [ "inject.js" ],
      "matches": [ "https://virtualagent.hpcloud.hp.com/*" ]
    }
  ],
  "host_permissions": [
    "https://virtualagent.hpcloud.hp.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://virtualagent.hpcloud.hp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
